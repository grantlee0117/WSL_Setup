# ============================================================
#  WSL_Setup ~/.zshrc — zsh + oh-my-zsh 引导
#  由 5-terminal/shell/setup.sh 部署到 ~/.zshrc（原有的会备份为 ~/.zshrc.bak）。
#  分工：本文件只做 omz 引导；工具接线（starship/zoxide/fzf/别名/历史/
#  autosuggestions/syntax-highlighting）全在 shell.zsh，和 bash 侧（.bashrc→shell.bash）对称。
# ============================================================

# ~/.local/bin 提前进 PATH：starship 与 ta 都装在这里，下面的 omz/提示符要先找得到。
# 去重：每次起 zsh 都跑本文件，已在 PATH 里就不再前置，避免嵌套 zsh / 重复 source 时越叠越长。
case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ─── oh-my-zsh ────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                              # 留空：提示符交给 starship（见 shell.zsh），bash/zsh 同款
zstyle ':omz:update' mode disabled        # 不自动更新，避免开终端时弹更新询问；要更新手动跑 `omz update`
# 只挂 omz 的内置插件；外部的 autosuggestions / syntax-highlighting 由 shell.zsh 末尾按正确顺序 source
#   git              → 海量 git 别名与补全（gst/gco/gp…，`alias | grep git` 可查）
#   sudo             → 连按两下 ESC，给当前/上条命令前面补 sudo
#   extract          → `extract 任意压缩包`，不用记 tar 各种参数
#   colored-man-pages→ man 手册上色
#   command-not-found→ 敲到没装的命令时提示用哪个 apt 包装
plugins=(git sudo extract colored-man-pages command-not-found)
[ -s "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# ─── 工具接线层（与 shell.bash 对称，zsh 语法）────────────
[ -f "$HOME/.config/wsl-setup/shell.zsh" ] && source "$HOME/.config/wsl-setup/shell.zsh"
