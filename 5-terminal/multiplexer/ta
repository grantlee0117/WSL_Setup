#!/usr/bin/env bash
# ============================================================
#  ta - tmux 快捷工具
#
#  ta          → 列出会话 / attach 到唯一会话
#  ta nn       → attach 到 nn，不存在则创建
#  ta nn 3     → 创建 nn + 自动开 3 个 pane
#  ta kill nn  → 关闭 nn
#  ta kill-all → 关闭所有
#  ta help     → 速查卡
# ============================================================

B='\033[1m'
C='\033[36m'
Y='\033[33m'
G='\033[32m'
D='\033[2m'
N='\033[0m'

show_help() {
    echo ""
    echo -e "${B}${C}━━━ ta 命令 ━━━${N}"
    echo ""
    echo -e "  ${B}ta${N}              列出会话 / 只有一个就直接连"
    echo -e "  ${B}ta ${Y}<名称>${N}        创建或连接到指定会话"
    echo -e "  ${B}ta ${Y}<名称> <数字>${N}  创建会话 + 自动开 N 个 pane"
    echo -e "  ${B}ta kill ${Y}<名称>${N}   关闭指定会话"
    echo -e "  ${B}ta kill-all${N}     关闭所有会话"
    echo -e "  ${B}ta help${N}         你正在看的这个"
    echo ""
    echo -e "${B}${C}━━━ tmux 操作 (前缀: Ctrl+A) ━━━${N}"
    echo ""
    echo -e "  ${B}分屏${N}"
    echo -e "  ${G}Ctrl+A %${N}        左右分屏"
    echo -e "  ${G}Ctrl+A \"${N}        上下分屏"
    echo ""
    echo -e "  ${B}切换 pane${N}"
    echo -e "  ${G}Ctrl+A ←↓↑→${N}    方向键切换"
    echo -e "  ${G}Ctrl+A C-q${N}      显示 pane 编号、按数字跳"
    echo -e "  ${D}也可以鼠标点击切换${N}"
    echo ""
    echo -e "  ${B}调整 pane 大小${N}"
    echo -e "  ${G}Alt+←↓↑→${N}       调整大小 (不需要前缀键)"
    echo -e "  ${D}也可以鼠标拖拽边框${N}"
    echo ""
    echo -e "  ${B}窗口${N}"
    echo -e "  ${G}Ctrl+A c${N}        新窗口"
    echo -e "  ${G}Ctrl+A 1-9${N}      切换到第 N 个窗口"
    echo ""
    echo -e "  ${B}会话${N}"
    echo -e "  ${G}Ctrl+A d${N}        后台挂起 (detach，进程在后台真的还跑着)"
    echo -e "  ${G}Ctrl+A s${N}        选择会话 (树状预览)"
    echo -e "  ${G}Ctrl+A Ctrl+S${N}   存会话骨架 (布局+文字、非进程)"
    echo -e "  ${G}Ctrl+A Ctrl+R${N}   恢复骨架 (重启后进程不会续跑)"
    echo ""
    echo -e "  ${B}Agent Team 布局${N}"
    echo -e "  ${G}Ctrl+A a${N}        三格布局 (1大+2小)"
    echo -e "  ${G}Ctrl+A q${N}        田字格 (4等分)"
    echo ""
    echo -e "  ${B}多格协同 / 监控${N}"
    echo -e "  ${G}Ctrl+A e${N}        广播输入开/关 (一条命令发给所有 pane，状态栏亮 SYNC)"
    echo -e "  ${G}Ctrl+A M${N}        给当前 pane 设静默告警 (安静 N 秒就提醒；0=关)"
    echo -e "  ${D}别的窗口有新输出会自动高亮该窗口标签${N}"
    echo ""
    echo -e "  ${B}其他${N}"
    echo -e "  ${G}Ctrl+A g${N}        浮动终端 (临时敲命令，不打乱分屏；exit/Ctrl+D 关)"
    echo -e "  ${G}Ctrl+A r${N}        重载配置"
    echo -e "  ${G}Ctrl+A Enter${N}    进入复制模式 (v选择, y复制)"
    echo ""
    echo -e "  ${B}自带默认键 (没改、tmux 出厂就有)${N}"
    echo -e "  ${G}Ctrl+A z${N}        当前 pane 全屏放大 / 还原 (高频)"
    echo -e "  ${G}Ctrl+A x${N}        关掉当前 pane"
    echo -e "  ${G}Ctrl+A n/p${N}      下一个 / 上一个窗口"
    echo -e "  ${G}Ctrl+A l${N}        跳回上一个用过的窗口 (来回切两个)"
    echo -e "  ${G}Ctrl+A ,${N}        给当前窗口改名"
    echo -e "  ${G}Ctrl+A &${N}        关掉当前窗口"
    echo ""
    echo -e "${D}  WezTerm / shell 键位见 5-terminal/cheatsheet.md${N}"
    echo ""
    echo -e "${B}${C}━━━ 挂长任务的典型流程 ━━━${N}"
    echo ""
    echo -e "  ${B}ta nn${N}           开一个专属会话（nn 只是会话名，随便起）"
    echo -e "  ${B}<你的长命令>${N}    跑起来（作者用 Night-Night: ${D}nn 15 60${N}，该工具非本仓提供）"
    echo -e "  ${G}Ctrl+A d${N}        断开去睡觉"
    echo -e "  ${B}ta nn${N}           回来 attach 看结果"
    echo ""
}

session_name="${1:-}"
pane_count="${2:-}"

if [[ "$session_name" == "help" || "$session_name" == "-h" || "$session_name" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$session_name" == "kill" ]]; then
    target="${2:-}"
    [[ -z "$target" ]] && echo "用法: ta kill <session-name>" && exit 1
    tmux kill-session -t "$target" 2>/dev/null && echo "已关闭: $target" || echo "不存在: $target"
    exit 0
fi

if [[ "$session_name" == "kill-all" ]]; then
    tmux kill-server 2>/dev/null && echo "已关闭所有会话" || echo "没有运行中的会话"
    exit 0
fi

if [[ -z "$session_name" ]]; then
    if ! tmux ls 2>/dev/null; then
        echo "没有运行中的会话。"
        echo "用法: ta <名称> 创建新会话 | ta help 查看帮助"
        exit 0
    fi
    tmux attach
    exit 0
fi

if tmux has-session -t "$session_name" 2>/dev/null; then
    tmux attach -t "$session_name"
else
    tmux new-session -d -s "$session_name"
    if [[ -n "$pane_count" && "$pane_count" -gt 1 ]]; then
        for ((i = 2; i <= pane_count; i++)); do
            if (( i % 2 == 0 )); then
                tmux split-window -h -t "$session_name"
            else
                tmux split-window -v -t "$session_name"
            fi
        done
        tmux select-layout -t "$session_name" tiled
    fi
    tmux attach -t "$session_name"
fi
