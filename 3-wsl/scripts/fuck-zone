#!/bin/bash
# 清理当前工作目录下所有 Zone.Identifier 文件（递归）
#   Enter   = 确认删除
#   Ctrl+C  = 取消退出

echo "正在扫描: $(pwd)"
echo "----------------------------------------"

mapfile -t files < <(find . -name "*Zone.Identifier")

if [ ${#files[@]} -eq 0 ]; then
    echo "干干净净，没有 Zone.Identifier 垃圾。"
    exit 0
fi

for f in "${files[@]}"; do
    echo "  $f"
done

echo "----------------------------------------"
echo "共发现 ${#files[@]} 个 Zone.Identifier 文件"
echo ""
read -p "按 Enter 确认删除，Ctrl+C 取消: "

find . -name "*Zone.Identifier" -delete
echo "已清理 ${#files[@]} 个文件。"
