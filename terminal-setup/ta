#!/usr/bin/env bash
# ============================================================
#  ta - tmux 快捷工具
#
#  ta          → 列出会话 / attach 到唯一会话
#  ta nn       → attach 到 nn，不存在则创建
#  ta nn 3     → 创建 nn + 自动开 3 个 pane
#  ta kill nn  → 关闭 nn
#  ta kill-all → 关闭所有
#  ta help     → 速查卡
# ============================================================

B='\033[1m'
C='\033[36m'
Y='\033[33m'
G='\033[32m'
D='\033[2m'
N='\033[0m'

show_help() {
    echo ""
    echo -e "${B}${C}━━━ ta 命令 ━━━${N}"
    echo ""
    echo -e "  ${B}ta${N}              列出会话 / 只有一个就直接连"
    echo -e "  ${B}ta ${Y}<名称>${N}        创建或连接到指定会话"
    echo -e "  ${B}ta ${Y}<名称> <数字>${N}  创建会话 + 自动开 N 个 pane"
    echo -e "  ${B}ta kill ${Y}<名称>${N}   关闭指定会话"
    echo -e "  ${B}ta kill-all${N}     关闭所有会话"
    echo -e "  ${B}ta help${N}         你正在看的这个"
    echo ""
    echo -e "${B}${C}━━━ tmux 操作 (前缀: Ctrl+A) ━━━${N}"
    echo ""
    echo -e "  ${B}分屏${N}"
    echo -e "  ${G}Ctrl+A %${N}        左右分屏"
    echo -e "  ${G}Ctrl+A \"${N}        上下分屏"
    echo ""
    echo -e "  ${B}切换 pane${N}"
    echo -e "  ${G}Ctrl+A h/j/k/l${N}  ← ↓ ↑ → 切换 (Vim 风格)"
    echo -e "  ${D}也可以鼠标点击切换${N}"
    echo ""
    echo -e "  ${B}调整 pane 大小${N}"
    echo -e "  ${G}Ctrl+A H/J/K/L${N}  大写 = 调整大小"
    echo -e "  ${D}也可以鼠标拖拽边框${N}"
    echo ""
    echo -e "  ${B}窗口${N}"
    echo -e "  ${G}Ctrl+A c${N}        新窗口"
    echo -e "  ${G}Ctrl+A 1-9${N}      切换到第 N 个窗口"
    echo ""
    echo -e "  ${B}会话${N}"
    echo -e "  ${G}Ctrl+A d${N}        后台挂起 (detach)"
    echo -e "  ${G}Ctrl+A S${N}        选择会话"
    echo -e "  ${G}Ctrl+A Ctrl+S${N}   保存会话 (重启后可恢复)"
    echo -e "  ${G}Ctrl+A Ctrl+R${N}   恢复会话"
    echo ""
    echo -e "  ${B}Agent Team 布局${N}"
    echo -e "  ${G}Ctrl+A A${N}        三格布局 (1大+2小)"
    echo -e "  ${G}Ctrl+A Q${N}        田字格 (4等分)"
    echo ""
    echo -e "  ${B}其他${N}"
    echo -e "  ${G}Ctrl+A r${N}        重载配置"
    echo -e "  ${G}Ctrl+A Enter${N}    进入复制模式 (v选择, y复制)"
    echo ""
    echo -e "${B}${C}━━━ WezTerm 操作 ━━━${N}"
    echo ""
    echo -e "  ${G}Ctrl+Shift+T${N}    新 Tab"
    echo -e "  ${G}Ctrl+Shift+W${N}    关闭 Tab"
    echo -e "  ${G}Ctrl+Shift+F${N}    搜索"
    echo -e "  ${G}Ctrl+Shift+C/V${N}  复制 / 粘贴"
    echo -e "  ${G}Ctrl+Shift+↑/↓${N}  调大 / 调小字体"
    echo -e "  ${G}Alt+1-5${N}         切换 Tab"
    echo -e "  ${G}右键${N}             粘贴"
    echo ""
    echo -e "${B}${C}━━━ Night-Night 典型流程 ━━━${N}"
    echo ""
    echo -e "  ${B}ta nn${N}           开会话"
    echo -e "  ${B}nn 15 60${N}        跑 Night-Night"
    echo -e "  ${G}Ctrl+A d${N}        去睡觉"
    echo -e "  ${B}ta nn${N}           第二天回来看"
    echo ""
}

session_name="${1:-}"
pane_count="${2:-}"

if [[ "$session_name" == "help" || "$session_name" == "-h" || "$session_name" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ "$session_name" == "kill" ]]; then
    target="${2:-}"
    [[ -z "$target" ]] && echo "用法: ta kill <session-name>" && exit 1
    tmux kill-session -t "$target" 2>/dev/null && echo "已关闭: $target" || echo "不存在: $target"
    exit 0
fi

if [[ "$session_name" == "kill-all" ]]; then
    tmux kill-server 2>/dev/null && echo "已关闭所有会话" || echo "没有运行中的会话"
    exit 0
fi

if [[ -z "$session_name" ]]; then
    if ! tmux ls 2>/dev/null; then
        echo "没有运行中的会话。"
        echo "用法: ta <名称> 创建新会话 | ta help 查看帮助"
        exit 0
    fi
    tmux attach
    exit 0
fi

if tmux has-session -t "$session_name" 2>/dev/null; then
    tmux attach -t "$session_name"
else
    tmux new-session -d -s "$session_name"
    if [[ -n "$pane_count" && "$pane_count" -gt 1 ]]; then
        for ((i = 2; i <= pane_count; i++)); do
            if (( i % 2 == 0 )); then
                tmux split-window -h -t "$session_name"
            else
                tmux split-window -v -t "$session_name"
            fi
        done
        tmux select-layout -t "$session_name" tiled
    fi
    tmux attach -t "$session_name"
fi
